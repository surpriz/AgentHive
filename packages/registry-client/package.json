{
  "name": "@agenthive/registry-client",
  "version": "0.1.0",
  "description": "Typed client for the agenthive.sh registry (index, agent cards, manifests, install snippets).",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "engines": { "node": ">=20" }
}
