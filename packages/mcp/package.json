{
  "name": "@agenthive-sh/mcp",
  "version": "0.6.0",
  "description": "MCP server exposing the agenthive.sh registry: search agents, read manifests, get install snippets.",
  "keywords": [
    "agenthive",
    "ai-agents",
    "mcp",
    "a2a",
    "registry",
    "mcp-server",
    "claude-code",
    "cursor"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://agenthive.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surpriz/AgentHive.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/surpriz/AgentHive/issues"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "agenthive-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bin.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@agenthive-sh/registry-client": "workspace:*",
    "@modelcontextprotocol/sdk": "~1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
