generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  memberships  Membership[]
  createdAt    DateTime     @default(now())
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  memberships Membership[]
  documents   Document[]
  createdAt   DateTime     @default(now())
}

model Membership {
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
  role        String    @default("member")

  @@id([userId, workspaceId])
}

model Document {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String
  title       String
  /** Path under STORAGE_DIR, e.g. ws_123/doc_456.pdf */
  storagePath String
  createdAt   DateTime  @default(now())
}
