{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm db:migrate && pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:ahp*",
      "destination": "/api/index?__path=/api/:ahp*"
    },
    {
      "source": "/docs/grading",
      "destination": "/api/index?__path=/docs/grading"
    },
    {
      "source": "/docs/leaderboard",
      "destination": "/api/index?__path=/docs/leaderboard"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__path=/sitemap.xml"
    },
    {
      "source": "/agents/:ahname/agent.json",
      "destination": "/api/index?__path=/agents/:ahname/agent.json"
    },
    {
      "source": "/agents/:ahname/agent.yaml",
      "destination": "/api/index?__path=/agents/:ahname/agent.yaml"
    },
    {
      "source": "/agents/:ahname/audit.json",
      "destination": "/api/index?__path=/agents/:ahname/audit.json"
    },
    {
      "source": "/agents/:ahname/benchmark.json",
      "destination": "/api/index?__path=/agents/:ahname/benchmark.json"
    },
    {
      "source": "/agents/:ahname/package.json",
      "destination": "/api/index?__path=/agents/:ahname/package.json"
    },
    {
      "source": "/agents/:ahname",
      "destination": "/api/index?__path=/agents/:ahname"
    },
    {
      "source": "/",
      "destination": "/api/index?__path=/"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index?__path=/dashboard"
    },
    {
      "source": "/leaderboard",
      "destination": "/api/index?__path=/leaderboard"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/benchmark",
      "schedule": "15 3 * * *"
    }
  ]
}
