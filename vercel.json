{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm db:migrate && pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__path=/sitemap.xml"
    },
    {
      "source": "/agents/:name/agent.json",
      "destination": "/api/index?__path=/agents/:name/agent.json"
    },
    {
      "source": "/agents/:name/agent.yaml",
      "destination": "/api/index?__path=/agents/:name/agent.yaml"
    },
    {
      "source": "/agents/:name",
      "destination": "/api/index?__path=/agents/:name"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
