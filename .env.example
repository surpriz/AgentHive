# Postgres (Neon). Use the dev branch locally.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Set DATABASE_URL=pglite://memory to run against an in-memory database (tests, CI).
# openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Moderation: logins allowed to read reports and take agents down, and where report mails go (defaults to EMAIL_FROM).
ADMIN_LOGINS=
REPORTS_TO=
